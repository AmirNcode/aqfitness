---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResults } from '../lib/results';
import PageHero from '../components/PageHero.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import CTASection from '../components/CTASection.astro';
import { bookingHref } from '../config/site';
import portrait from '../assets/photos/alejandro-portrait.jpg';

const results = await getResults();
const quotes = results.filter((r) => r.quote);
const photos = results.filter((r) => !r.quote);
---
<BaseLayout
  title="Client results and testimonials"
  description="Before and after transformations and testimonials from Aquam Fitness 1:1 coaching clients: fat loss, strength, confidence and habits that last."
  mood="coaching"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Results', path: '/results/' }]}
>
  <PageHero
    mood="coaching"
    title="Client results"
    lead="Weight lost, strength gained and, more often than not, a better relationship with food. These are real clients who stayed consistent and made it a lifestyle."
  />

  <section class="section">
    <div class="wrap">
      <div class="intro">
        <h2>In their words</h2>
      </div>
      <div class="quotes">
        {quotes.map((q) => (
          <TestimonialCard quote={q.quote!} firstName={q.firstName} placeholder={q.placeholder} image={q.image} videoUrl={q.videoUrl} />
        ))}
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="intro">
        <h2>More transformations</h2>
      </div>
      <TransformationGallery items={photos} layout="grid" label="Client transformation photos" />
      <p class="small note">Results vary from person to person and depend on consistency, starting point and lifestyle. See our <a href="/disclaimer/">health disclaimer</a>.</p>
    </div>
  </section>

  <CTASection
    heading="Your turn."
    text="Book a free 30-minute consult and let's talk about your goals."
    primary={{ label: 'Book a free consult', href: bookingHref('consult') }}
    secondary={{ label: 'Explore 1:1 coaching', href: '/coaching/' }}
    image={portrait}
  />
</BaseLayout>

<style>
  .intro { margin-bottom: 32px; }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; align-items: start; }
  .quotes > :global(*) { background: var(--sand); }
  .note { margin-top: 28px; color: var(--slate); }
</style>
