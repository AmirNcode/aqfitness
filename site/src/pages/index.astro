---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WeekStrip from '../components/WeekStrip.astro';
import StatRow from '../components/StatRow.astro';
import Pillars from '../components/Pillars.astro';
import CaseStudy from '../components/CaseStudy.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CTASection from '../components/CTASection.astro';
import { site, bookingHref } from '../config/site';
import { strictContent } from '../lib/env';
import { assertContentReady } from '../lib/content-guard';
import friendly from '../assets/photos/alejandro-friendly.jpg';
import gym from '../assets/photos/alejandro-gym.jpg';

const stats = (await getCollection('stats')).map((e) => e.data).sort((a, b) => a.order - b.order);
const results = (await getCollection('testimonials')).map((e) => e.data);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
assertContentReady([...stats, ...results], strictContent());

const featured = results.find((r) => r.featured && r.quote);
const galleryItems = results.filter((r) => !r.quote).slice(0, 8);
---
<BaseLayout
  title="Aquam Fitness | Team performance and 1:1 fitness coaching in Toronto"
  description="Aquam Performance is a 12-week fitness and nutrition program that helps teams build healthier habits, sharper focus and more energy. Plus 1:1 online coaching."
>
  <PageHero
    size="xl"
    title="Competitive edge starts with your people."
    lead="Aquam Performance is a 12-week fitness and nutrition program for teams of 8 or more. Your people build habits that bring more energy, sharper focus and fewer sick days. You get a progress report every 4 weeks."
  >
    <div class="btn-row">
      <a class="btn btn-primary btn-lg" href={bookingHref('discovery')}>Book a discovery call</a>
      <a class="btn btn-ghost btn-lg" href="#how">How the 12 weeks work</a>
    </div>
    <p class="aside-link">Looking for coaching for yourself? <a href="/coaching/">See 1:1 online coaching</a>.</p>
    <div class="hero-strip"><WeekStrip /></div>
  </PageHero>

  <section class="section dark">
    <div class="wrap">
      <h2 class="narrow">A sedentary workforce isn't just a wellness problem. It's a performance problem.</h2>
      <StatRow stats={stats.slice(0, 3)} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="intro">
        <h2>We coach movement, nutrition and recovery</h2>
        <p class="lead">Three areas, taught and coached week by week, so new routines turn into habits people keep long after the program ends.</p>
      </div>
      <Pillars />
    </div>
  </section>

  <section class="section surface" id="how">
    <div class="wrap two-col">
      <div>
        <h2>12 weeks. Two phases. One team.</h2>
        <p class="lead">Built around competition, structure and weekly accountability. We handle the day-to-day coaching and tracking, so HR and leadership don't take on extra work.</p>
        <a class="btn btn-primary" href="/teams/">See the full program</a>
      </div>
      <div class="phases">
        <div>
          <h3>Weeks 1–4: Foundation</h3>
          <p>Deliberately simple. Everyone learns the app, the routine and a few new food habits. No leaderboard yet, so nobody gets left behind.</p>
        </div>
        <div>
          <h3>Weeks 5–12: the Habit Shift</h3>
          <p>The leaderboard opens and team competition kicks in. Points come mostly from daily habits, plus training, movement and meal tracking.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap proof">
      <div class="coach">
        <Image src={gym} alt="Alejandro Rivas, head coach, in the gym" widths={[400, 800]} sizes="(max-width: 900px) 90vw, 400px" class="coach-photo" />
        <div>
          <h2>Coached by someone who has led 5,000+ group classes</h2>
          <p>Alejandro Rivas has coached more than {site.proof.clients} clients since 2020 and led {site.proof.classes} group fitness classes. He's a Precision Nutrition certified coach and a certified personal trainer.</p>
          <a href="/about/">Meet Alejandro</a>
        </div>
      </div>
      <CaseStudy />
    </div>
  </section>

  <section class="section surface mood-coaching door">
    <div class="wrap door-inner">
      <Image src={friendly} alt="Alejandro smiling and pointing at the camera" widths={[480, 960]} sizes="(max-width: 900px) 90vw, 480px" class="door-photo" />
      <div>
        <h2>Not here for your team? Train with Alejandro one-on-one.</h2>
        <p class="lead">Online coaching for busy women over 30 who want to get stronger, leaner and confident again, without giving up the foods and social life they love.</p>
        <a class="btn btn-primary btn-lg" href="/coaching/">Explore 1:1 coaching</a>
      </div>
    </div>
  </section>

  <section class="section mood-coaching">
    <div class="wrap">
      <div class="intro">
        <h2>Results from our 1:1 clients</h2>
        <p class="lead">Before and after photos from clients who built the habits and kept them.</p>
      </div>
      <TransformationGallery items={galleryItems} layout="row" label="Client transformation photos" />
      {featured && (
        <div class="featured">
          <TestimonialCard quote={featured.quote!} firstName={featured.firstName} placeholder={featured.placeholder} videoUrl={featured.videoUrl} />
          <a class="btn btn-ghost" href="/results/">See all client results</a>
        </div>
      )}
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="intro">
        <h2>From the blog</h2>
      </div>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog/">Read all posts</a>
    </div>
  </section>

  <CTASection
    heading="Are you ready to compete?"
    text="Book a 30-minute discovery call to see how Aquam Performance fits your team."
    primary={{ label: 'Book a discovery call', href: bookingHref('discovery') }}
    secondary={{ label: 'Send a message', href: '/contact/?interest=teams' }}
    image={gym}
  />
</BaseLayout>

<style>
  .aside-link { margin-top: 20px; font-size: 1rem; }
  .hero-strip { margin-top: clamp(40px, 6vw, 72px); max-width: 100%; }
  .narrow { max-width: 22ch; margin-bottom: 40px; }
  .intro { max-width: 720px; margin-bottom: 40px; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .phases { display: grid; gap: 28px; border-top: 2px solid var(--black); padding-top: 28px; }
  .phases h3 { margin-bottom: 8px; }
  .phases p { color: var(--text); margin: 0; }
  .proof { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .coach { display: grid; grid-template-columns: 200px 1fr; gap: 28px; align-items: end; }
  .coach-photo { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: grayscale(1); }
  .coach h2 { font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); }
  .door-inner { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .door-photo { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); }
  .featured { display: grid; grid-template-columns: minmax(0, 640px) auto; gap: 24px; align-items: end; margin-top: 32px; }
  .posts { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .posts a { display: block; height: 100%; padding: 24px; background: var(--white); color: var(--black); text-decoration: none; border-top: 3px solid var(--black); }
  .posts a:hover { border-top-color: var(--accent); }
  .posts h3 { font-size: 1.5rem; }
  .posts p { color: var(--text); margin: 0; font-size: 1rem; }
  @media (max-width: 900px) {
    .two-col, .proof, .door-inner, .featured { grid-template-columns: 1fr; }
    .posts { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .coach { grid-template-columns: 1fr; }
    .coach-photo { max-width: 240px; }
  }
</style>
