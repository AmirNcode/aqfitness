---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist. Head back to the Aquam Fitness home page.">
  <section class="section surface">
    <div class="wrap stack">
      <h1 class="display-xl">Page not found</h1>
      <p class="lead">This page moved or never existed. If you followed a link from our old site, try the pages below.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
