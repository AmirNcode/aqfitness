---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Offer from '../components/Offer.astro';
import Steps from '../components/Steps.astro';
import TransformationGallery from '../components/TransformationGallery.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import CoachCard from '../components/CoachCard.astro';
import { site, bookingHref } from '../config/site';
import { serviceLd, faqLd } from '../lib/schema';
import portrait from '../assets/photos/alejandro-portrait.jpg';

const photos: Record<string, ImageMetadata | undefined> = { alejandro: portrait };

const faq = (await getCollection('faqCoaching')).map((e) => e.data).sort((a, b) => a.order - b.order);
const results = (await getCollection('testimonials')).map((e) => e.data);
const quotes = results.filter((r) => r.quote).slice(0, 3);
const gallery = results.filter((r) => !r.quote).slice(8, 16);

// Both options share the same nutrition coaching and support. Online coaching adds training.
const shared = [
  'Flexible nutrition coaching built around foods you enjoy, where all foods fit',
  'Habits, meal planning and meal prep strategies',
  'Education on protein, macros and calories',
  'Weekly check-ins and plan adjustments',
  'Progress tracking with measurements, photos and the scale (optional)',
  'Messaging support in the app',
];
const training = [
  'A training plan built around your schedule: 3–4 workouts a week, 40–50 minutes each',
  'Exercise video reviews to check your form, when you need them',
];

const url = new URL('/coaching/', Astro.site).href;
const description =
  'One-on-one online fitness and nutrition coaching for busy women over 30. Get stronger, leaner and confident again, without restrictive diets.';
---
<BaseLayout
  title="1:1 online fitness and nutrition coaching for women over 30"
  description={description}
  mood="coaching"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: '1:1 Coaching', path: '/coaching/' }]}
  jsonLd={[
    serviceLd({ name: '1:1 online fitness and nutrition coaching', description, url, areaServed: [site.serviceArea.virtual] }),
    faqLd(faq),
  ]}
>
  <PageHero
    mood="coaching"
    size="xl"
    title="Get stronger, leaner and confident again"
    lead="1:1 coaching for women 30+ who want to feel stronger, leaner, and more confident in their bodies, without giving up the foods they love or spending hours in the gym."
  >
    <p class="lead hero-more">We'll help you build the strength, nutrition habits, and consistency to get results that fit into your real life and keep them forever.</p>
    <div class="btn-row">
      <a class="btn btn-primary btn-lg" href={bookingHref('consult')}>Book a free consult</a>
      <a class="btn btn-ghost btn-lg" href="/free-guide/">Get the free meal-prep guide</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap who">
      <div>
        <h2>Built for moms who put everyone else first</h2>
        <p class="lead">We work with professional child caregivers, aka momma bears. Women 30+ who have spent years taking care of everyone else and are finally ready to make themselves a priority, without giving up their social life or making fitness a second job.</p>
        <p>Maybe you've tried every diet out there, and they all worked… for a few weeks. Maybe you've been spinning your wheels, wondering why what used to work doesn't seem to work anymore.</p>
        <p>Either way, <strong>you're not starting from zero. You just haven't found an approach that works for your life yet.</strong></p>
        <p><strong>Ready to stop starting over? Let's get to work.</strong></p>
      </div>
      <figure class="quote">
        <blockquote>
          <p>“I love hearing how happy these women are when they reach their goal, and knowing they can keep it. It's a rewarding feeling that's hard to explain.”</p>
        </blockquote>
        <figcaption>Alejandro Rivas, founder and head coach</figcaption>
      </figure>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="intro">
        <h2>Two ways to work together</h2>
        <p class="lead">Both run online through the Trainerize app and include the same nutrition coaching, weekly check-ins and support. Online coaching adds your training.</p>
      </div>
      <div class="offers">
        <Offer
          title="Online coaching"
          summary="Everything in nutrition coaching, plus a training plan built around your schedule."
          includes={[...training, ...shared]}
          best="you want one plan for training and food, and someone keeping you accountable."
        />
        <Offer
          title="Nutrition coaching"
          summary="The same coaching, check-ins and support, for when you already have your training covered."
          includes={shared}
          best="you're happy with your training but your nutrition keeps holding you back."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="intro">
        <h2>How it works</h2>
      </div>
      <Steps
        steps={[
          { title: 'Free consult', text: 'A free 30-minute call to find out where you’re at, how you got to this point and what your goals are. We’ll also look at your schedule and what has or hasn’t worked for you before.' },
          { title: 'Your plan', text: 'We build your training and nutrition around your life, your tastes and your starting point.' },
          { title: 'Weekly check-ins', text: 'You check in every week in the app. It’s not just about weight loss: we ask about your energy, sleep, stress and performance, because we want you to look and feel your best.' },
          { title: 'Adjust and keep going', text: 'We use your check-in data to decide what to change, whether that’s your training, your calories or your habits. Then we adjust your plan and teach you the why, so the habits stick for life.' },
        ]}
      />
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="intro">
        <h2>Meet your coaches</h2>
        <p class="lead">Whoever you work with, you get the same approach: a plan built around your life, weekly check-ins and a coach in your corner.</p>
      </div>
      <div class="coaches">
        {site.team.map((c) => <CoachCard {...c} image={photos[c.id]} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap philosophy">
      <div>
        <h2>No diets. No banned foods. Aggressive patience.</h2>
        <blockquote class="motto"><p>“Treat this program as something you can and will do for the rest of your life, not something you’ll do for three months.”</p></blockquote>
      </div>
      <ul class="beliefs">
        <li>
          <h3>All foods fit</h3>
          <p>There's no such thing as good or bad food. You'll learn to enjoy treats, eat out and still make progress.</p>
        </li>
        <li>
          <h3>Lift weights (you won't get bulky)</h3>
          <p>Resistance training and daily movement are at the core. Lifting makes you stronger, leaner and more toned.</p>
        </li>
        <li>
          <h3>Aggressive patience</h3>
          <p>Work as hard as you can toward your goals, and be patient with the timeline. Lasting change takes time.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="intro">
        <h2>Real clients, real habits</h2>
      </div>
      <div class="quotes">
        {quotes.map((q) => (
          <TestimonialCard quote={q.quote!} firstName={q.firstName} placeholder={q.placeholder} image={q.image} videoUrl={q.videoUrl} />
        ))}
      </div>
      <div class="more">
        <TransformationGallery items={gallery} layout="row" label="More client transformation photos" />
        <a class="btn btn-ghost" href="/results/">See all client results</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <FAQ items={faq} heading="Questions about 1:1 coaching" />
    </div>
  </section>

  <CTASection
    heading="Ready to feel strong again?"
    text="Book a free 30-minute consult. No pressure, just a conversation about your goals."
    primary={{ label: 'Book a free consult', href: bookingHref('consult') }}
    secondary={{ label: 'Get the free guide', href: '/free-guide/' }}
    image={portrait}
  />
</BaseLayout>

<style>
  .hero-more { max-width: 52ch; margin: -12px 0 28px; }
  .intro { max-width: 760px; margin-bottom: 40px; }
  .who { display: grid; grid-template-columns: 3fr 2fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .quote { margin: 0; background: var(--peach); border-radius: var(--radius); padding: clamp(24px, 3vw, 40px); }
  .quote blockquote { margin: 0; }
  .quote p { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem); line-height: 1.15; margin: 0 0 16px; }
  .quote figcaption { font-weight: 600; }
  .offers, .coaches { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .philosophy { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .motto { margin: 24px 0 0; padding-left: 20px; border-left: 4px solid var(--accent); }
  .motto p { font-size: var(--fs-lead); margin: 0; }
  .beliefs { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .beliefs li { background: var(--sand); border-radius: var(--radius); padding: 20px 24px; }
  .beliefs h3 { margin-bottom: 6px; }
  .beliefs p { margin: 0; color: var(--text); }
  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .quotes :global(.t) { background: var(--white); }
  .more { margin-top: 40px; display: grid; gap: 20px; }
  .more .btn { justify-self: start; }
  .more > :global(.gallery) { min-width: 0; }
  @media (max-width: 960px) {
    .who, .offers, .coaches, .philosophy { grid-template-columns: 1fr; }
    .quotes { grid-template-columns: 1fr; }
  }
</style>
