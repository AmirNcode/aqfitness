---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bookingHref } from '../../config/site';
---
<BaseLayout title="Message sent" description="Thanks for contacting Aquam Fitness.">
  <section class="section surface">
    <div class="wrap stack">
      <h1>Message sent</h1>
      <p class="lead">Thanks for reaching out. We'll get back to you within 2 business days. You'll also get a confirmation email shortly.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={bookingHref('discovery')}>Book a call now</a>
        <a class="btn btn-ghost" href="/">Back to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>
