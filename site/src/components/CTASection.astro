---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  heading: string;
  text?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  image?: ImageMetadata;
  imageAlt?: string;
}
const { heading, text, primary, secondary, image, imageAlt = '' } = Astro.props;
---
<section class:list={['cta', 'dark', { 'has-image': image }]}>
  {image && <Image class="bg" src={image} alt={imageAlt} widths={[720, 1280, 1920]} sizes="100vw" />}
  <div class="wrap inner">
    <h2 class="display-xl">{heading}</h2>
    {text && <p class="lead">{text}</p>}
    <div class="btn-row">
      <a class="btn btn-primary btn-lg" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn-ghost btn-lg" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; padding-block: clamp(80px, 12vw, 160px); isolation: isolate; }
  .bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    filter: grayscale(1) contrast(1.1);
  }
  .has-image::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.6) 55%, rgb(0 0 0 / 0.35) 100%);
  }
  h2 { max-width: 14ch; }
  .lead { max-width: 46ch; margin-bottom: 28px; color: rgb(255 255 255 / 0.85); }
</style>
