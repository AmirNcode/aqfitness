---
// One coach: photo (or a placeholder until it arrives), name, role, one line, link to their story.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props {
  id: string;
  firstName: string;
  lastName: string | null;
  role: string;
  summary: string;
  image?: ImageMetadata;
}
const { id, firstName, lastName, role, summary, image } = Astro.props;
---
<article class="coach">
  {image
    ? <Image src={image} alt={`${firstName}, ${role.toLowerCase()}`} widths={[240, 480]} sizes="(max-width: 700px) 40vw, 200px" class="photo" />
    : <div class="photo empty"><Placeholder label={`${firstName}'s photo`} /></div>}
  <div>
    <h3>{firstName} {lastName ?? <Placeholder label="last name" />}</h3>
    <p class="role">{role}</p>
    <p class="summary">{summary}</p>
    <a href={`/about/#${id}`}>Read {firstName}'s story</a>
  </div>
</article>

<style>
  .coach { display: grid; grid-template-columns: 180px 1fr; gap: 24px; align-items: start; background: var(--white); border-radius: var(--radius); padding: 20px; }
  .photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: calc(var(--radius) - 6px); }
  .empty { display: grid; place-items: center; padding: 12px; text-align: center; background: var(--sand); }
  h3 { margin-bottom: 4px; }
  .role { font-weight: 600; color: var(--accent-ink); margin: 0 0 12px; }
  .summary { color: var(--text); margin: 0 0 12px; }
  @media (max-width: 520px) { .coach { grid-template-columns: 1fr; } .photo { max-width: 220px; } }
</style>
