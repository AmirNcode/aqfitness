---
// Progressive enhancement for Netlify forms marked [data-enhance]: submit with fetch and
// stay on the page (or go to the form's action). Without JS the forms post normally.
---
<script>
  const encode = (form: HTMLFormElement) =>
    new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();

  document.querySelectorAll<HTMLFormElement>('form[data-enhance]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      button?.setAttribute('disabled', '');
      if (status) status.textContent = 'Sending…';
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encode(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        if (form.dataset.enhance === 'redirect') {
          window.location.assign(form.action);
          return;
        }
        form.reset();
        if (status) status.textContent = form.dataset.success ?? 'Thanks! You’re subscribed.';
      } catch {
        if (status) status.textContent = 'That didn’t go through. Check your connection and try again.';
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  });
</script>
