---
import { Image } from 'astro:assets';
import checkIn from '../assets/app/check-in-form.png';
import tasks from '../assets/app/daily-tasks.png';
import nutrition from '../assets/app/nutrition-tracking.png';
import rules from '../assets/app/challenge-rules.png';
import leaderboard from '../assets/app/leaderboard.png';

const screens = [
  { src: tasks, alt: 'Daily task list in the app showing completed workouts and walks', caption: 'Daily tasks' },
  { src: nutrition, alt: 'Nutrition tracking screen showing meals added, calories and protein', caption: 'Nutrition tracking' },
  { src: checkIn, alt: 'Weekly check-in form asking about sleep, energy and productivity', caption: 'Weekly check-in' },
  { src: rules, alt: 'Team challenge rules listing how participants earn points', caption: 'Challenge rules' },
  { src: leaderboard, alt: 'Team leaderboard podium with first, second and third place', caption: 'Leaderboard (names hidden)' },
];
---
<div class="scroller" tabindex="0" role="region" aria-label="Screenshots from the coaching app">
<ul class="screens">
  {screens.map((s) => (
    <li>
      <figure>
        <Image src={s.src} alt={s.alt} widths={[280, 560]} sizes="(max-width: 700px) 70vw, 280px" />
        <figcaption>{s.caption}</figcaption>
      </figure>
    </li>
  ))}
</ul>
</div>

<style>
  .screens {
    list-style: none; margin: 0; padding: 0 0 12px;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 280px); gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory;
  }
  li { scroll-snap-align: start; }
  figure { margin: 0; }
  img { width: 100%; height: 360px; object-fit: cover; object-position: top; border: 1px solid var(--line); background: var(--white); }
  figcaption { margin-top: 10px; font-weight: 600; }
</style>
