---
import HubSpotForm from './HubSpotForm.astro';
interface Props { id?: string; }
const { id = 'newsletter' } = Astro.props;
---
<section class="newsletter" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>Get the ultimate blueprint for fat loss</h2>
  <div class="form-panel"><HubSpotForm id={id} /></div>
</section>
<style>
  .newsletter { display: grid; gap: 12px; max-width: 460px; }
  h2 { font-family: var(--font-body); font-size: 1rem; text-transform: none; line-height: 1.5; margin: 0; }
  .form-panel { background: var(--white); color: var(--text); border-radius: var(--radius); padding: 16px; }
</style>
