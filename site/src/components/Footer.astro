---
import NewsletterForm from './NewsletterForm.astro';
import Placeholder from './Placeholder.astro';
import { site } from '../config/site';

const year = new Date().getFullYear();
---
<footer class="site-footer dark">
  <div class="wrap">
    <p class="tagline" aria-hidden="true">Eat. Train. Live.</p>
    <div class="grid">
      <div class="col">
        <NewsletterForm id="footer-newsletter" />
        <p class="small"><a href="/free-guide/">Get the free meal-prep guide</a></p>
      </div>
      <div class="col">
        <h2 class="h">Explore</h2>
        <ul>
          <li><a href="/teams/">Habit Shift for teams</a></li>
          <li><a href="/coaching/">1:1 online coaching</a></li>
          <li><a href="/results/">Client results</a></li>
          <li><a href="/about/">About Alejandro</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>
      <div class="col">
        <h2 class="h">Get in touch</h2>
        <ul>
          <li><a href="/book/">Book a call</a></li>
          <li><a href="/contact/">Send a message</a></li>
          <li>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <Placeholder label="business email" />}</li>
          <li><a href={site.social.instagram} rel="me">Instagram</a></li>
          {site.social.linkedin && <li><a href={site.social.linkedin} rel="me">LinkedIn</a></li>}
        </ul>
        <p class="small muted">In person across the {site.serviceArea.inPerson}. Online everywhere in {site.serviceArea.virtual}.</p>
      </div>
    </div>
    <div class="legal small">
      <p>© {year} Aquam Fitness</p>
      <ul>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/disclaimer/">Health disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(56px, 7vw, 96px) 32px; }
  .tagline {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(3rem, 1rem + 9vw, 8.5rem); line-height: 0.9; letter-spacing: -0.01em;
    margin: 0 0 clamp(40px, 5vw, 64px); max-width: none; color: var(--white);
  }
  .grid { display: grid; gap: 40px; grid-template-columns: 1.4fr 1fr 1fr; }
  .h { font-family: var(--font-body); text-transform: none; font-size: 1rem; font-weight: 600; color: var(--muted-dark); margin-bottom: 12px; }
  ul { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
  .col a { color: var(--white); text-decoration: none; }
  .col a:hover { color: var(--accent); text-decoration: underline; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 56px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 0.18); color: var(--muted-dark);
  }
  .legal p { margin: 0; }
  .legal ul { display: flex; gap: 20px; margin: 0; }
  .legal a { color: var(--muted-dark); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
