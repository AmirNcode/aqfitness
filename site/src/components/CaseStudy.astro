---
// Habit Shift pilot results. Figures live in src/content/pilot.yaml.
import { getCollection } from 'astro:content';

const results = (await getCollection('pilot')).map((e) => e.data).sort((a, b) => a.order - b.order);
---
<article class="case">
  <p class="kicker">Habit Shift pilot, 2026</p>
  <h3>From a 5-person pilot to 22 employees</h3>
  <dl>
    {results.map((r) => (
      <div><dt>{r.value}</dt><dd>{r.label}</dd></div>
    ))}
  </dl>
  <p class="source small">Source: Habit Shift coaching data, 2026. An 8-week pilot with 5 employees, then 22 employees across two coaching teams. Scores are self-reported in weekly check-ins on a 1–10 scale.</p>
</article>

<style>
  .case { border: 2px solid var(--black); padding: clamp(20px, 3vw, 32px); background: var(--white); }
  .kicker { font-weight: 600; color: var(--accent-ink); margin-bottom: 8px; }
  h3 { font-size: var(--fs-h3); }
  dl { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; margin: 20px 0; }
  dl div { border-top: 1px solid var(--line); padding-top: 12px; }
  dt { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); line-height: 1; color: var(--accent-ink); margin-bottom: 6px; }
  dd { margin: 0; color: var(--text); font-size: 1rem; }
  .source { margin: 0; color: var(--slate); }
  @media (max-width: 520px) { dl { grid-template-columns: 1fr; } }
</style>
