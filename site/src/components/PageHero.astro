---
// Page-opening block. `performance` is paper + uppercase; `coaching` is sand + sentence case (via mood tokens).
interface Props {
  title: string;
  lead?: string;
  mood?: 'performance' | 'coaching';
  size?: 'xl' | 'l';
}
const { title, lead, mood = 'performance', size = 'l' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['hero', 'surface', `mood-${mood}`, { split: hasAside }]}>
  <div class="wrap inner">
    <div class="copy">
      <slot name="eyebrow" />
      <h1 class:list={[{ 'display-xl': size === 'xl' }]}>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {hasAside && <div class="aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .hero { padding-block: clamp(48px, 8vw, 112px) clamp(56px, 8vw, 104px); }
  .inner { display: grid; gap: clamp(32px, 5vw, 64px); }
  .split .inner { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; }
  h1 { max-width: 16ch; }
  .lead { max-width: 52ch; margin-bottom: 28px; }
  @media (max-width: 900px) { .split .inner { grid-template-columns: 1fr; } }
</style>
