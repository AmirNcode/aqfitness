---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props {
  quote: string;
  firstName: string | null;
  placeholder?: boolean;
  image?: ImageMetadata;
  videoUrl?: string | null;
}
const { quote, firstName, placeholder = false, image, videoUrl } = Astro.props;
---
<figure class="t">
  {image && <Image class="photo" src={image} alt="Client before and after photos" widths={[320, 640]} sizes="(max-width: 700px) 90vw, 320px" />}
  <blockquote><p>{quote}</p></blockquote>
  <figcaption>
    {firstName ? <span class="name">{firstName}</span> : placeholder ? <Placeholder label="client first name" /> : <span class="name">Aquam Fitness client</span>}
    {videoUrl && <a href={videoUrl} rel="noopener">Watch the video on Instagram</a>}
  </figcaption>
</figure>

<style>
  .t { margin: 0; display: grid; gap: 16px; align-content: start; background: var(--white); border-radius: var(--radius); padding: 20px; }
  .photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: calc(var(--radius) * 0.6); }
  blockquote { margin: 0; }
  blockquote p { font-size: 1.125rem; line-height: 1.5; margin: 0; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: var(--fs-small); }
  .name { font-weight: 600; }
</style>
