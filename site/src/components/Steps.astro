---
// A real sequence, so it's numbered.
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="n" aria-hidden="true">{i + 1}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 24px; }
  li { background: var(--white); border-radius: var(--radius); padding: 24px; }
  .n {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--accent); color: var(--black); font-family: var(--font-display); font-weight: 800; font-size: 1.5rem;
    margin-bottom: 16px;
  }
  h3 { font-size: 1.5rem; margin-bottom: 8px; }
  p { color: var(--text); margin: 0; }
</style>
