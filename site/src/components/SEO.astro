---
import { allowIndexing } from '../lib/env';
import { organizationLd, websiteLd, breadcrumbLd } from '../lib/schema';

export interface Crumb {
  name: string;
  path: string;
}
interface Props {
  title: string;
  description: string;
  ogImage?: 'default' | 'performance' | 'coaching';
  type?: 'website' | 'article';
  jsonLd?: object[];
  breadcrumbs?: Crumb[];
}

const { title, description, ogImage = 'default', type = 'website', jsonLd = [], breadcrumbs } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title.includes('Aquam Fitness') ? title : `${title} | Aquam Fitness`;
const image = new URL(`/og/${ogImage}.png`, site).href;
const graph = [
  organizationLd(site.href),
  websiteLd(site.href),
  ...(breadcrumbs ? [breadcrumbLd(breadcrumbs.map((c) => ({ name: c.name, url: new URL(c.path, site).href })))] : []),
  ...jsonLd,
];
// Keep "</script>" sequences out of inline JSON-LD.
const serialize = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!allowIndexing() && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Aquam Fitness" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{graph.map((o) => <script type="application/ld+json" set:html={serialize(o)} />)}
